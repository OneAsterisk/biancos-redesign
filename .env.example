# Google Calendar iCal integration (optional).
# The Schedule page can load classes from a Google Calendar "secret address in
# iCal format." When unset, it falls back to the static schedule in
# src/data/classes.ts. See README.md for setup steps.

# Recommended: keep the secret iCal URL server-side.
# Vercel uses this in api/calendar.ts; Vite dev proxies /api/calendar to it.
#
# Do NOT prefix this with VITE_ unless you intentionally want the URL exposed in
# the browser bundle.
GOOGLE_CALENDAR_ICAL_URL=

# Google Calendar integration (optional).
# When both are set, the Schedule page loads classes live from the gym's
# Google Calendar. When unset, it falls back to the static schedule in
# src/data/classes.ts. See README.md for setup steps.

# The calendar's ID — find it under Google Calendar → Settings → Integrate
# calendar → "Calendar ID" (e.g. abc123@group.calendar.google.com).
VITE_GOOGLE_CALENDAR_ID=

# A Google API key with the "Google Calendar API" enabled.
# The calendar must be made public for read-only (API-key) access to work.
VITE_GOOGLE_API_KEY=
